---
// The mark colors are fixed; the wordmark follows the current text color.
// Styles are scoped CSS rather than Tailwind utilities so the logo renders
// identically on the Starlight docs pages, which do not load Tailwind.
---

<svg viewBox="0 0 32 32" fill="none" class="mark" aria-hidden="true">
  <rect
    x="2.5"
    y="2.5"
    width="17"
    height="17"
    rx="4.5"
    stroke="var(--vd-accent)"
    stroke-opacity="0.45"
    stroke-width="2"
  ></rect>
  <rect x="12" y="12" width="17.5" height="17.5" rx="4.5" fill="var(--vd-accent)"></rect>
  <path
    d="M17 21.2l2.5 2.5 5-5.4"
    stroke="#0b0f0d"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
<span class="word">
  Vitest<span class="word-accent">Dedup</span>
</span>

<style>
  .mark {
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
  }
  .word {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  @media (min-width: 40rem) {
    .word {
      font-size: 1.125rem;
    }
  }
  .word-accent {
    color: var(--vd-accent);
  }
</style>
