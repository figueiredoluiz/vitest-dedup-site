---
import { sampleReport } from '../../lib/report';
import FindingCard from './FindingCard.astro';

const { summary, meta } = sampleReport;

const stats = [
  { label: 'tests analyzed', value: summary.testsAnalyzed.toLocaleString('en-US') },
  { label: 'files analyzed', value: summary.filesAnalyzed.toString() },
  { label: 'findings', value: summary.findings.toString() },
  { label: 'detection time', value: `${summary.detectionTimeMs.toLocaleString('en-US')} ms` },
] as const;
---

<section id="report" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Reports</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">What a run tells you</h2>
    <p class="mt-3 leading-relaxed text-muted">
      Every finding carries a rule, a severity, a verdict, stable fingerprints, and full participant
      locations — the fields the <code class="font-mono text-[13px]">json</code> and
      <code class="font-mono text-[13px]">sarif</code> reporters write for machines.
    </p>
  </div>

  <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="rounded-xl border border-line bg-panel px-5 py-4">
          <dt class="text-xs font-medium uppercase tracking-wide text-muted">{stat.label}</dt>
          <dd class="mt-1.5 font-mono text-2xl font-bold text-ink">{stat.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-6 space-y-3">
    {sampleReport.findings.map((finding) => <FindingCard finding={finding} />)}
  </div>

  <p class="mt-5 text-xs leading-relaxed text-muted">
    {meta.note} Structured to consume real <code class="font-mono">--reporters json</code> output
    later without changing these components.
  </p>

  <div class="mt-6">
    <a href="/docs/reports/" class="text-sm font-semibold text-accent hover:underline"
      >All five reporters →</a
    >
  </div>
</section>
