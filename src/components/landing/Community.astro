---
import { siteConfig } from '../../lib/site';

const links = [
  {
    title: 'Source code',
    body: 'Rust core, npm launcher, and the verification suite that gates every merge.',
    href: siteConfig.repoUrl,
    external: true,
    disabled: !siteConfig.repoUrl,
  },
  {
    title: 'Issues',
    body: 'Bug reports and rule discussions. Check the existing list before opening a new one.',
    href: siteConfig.repoUrl ? `${siteConfig.repoUrl}/issues` : '',
    external: true,
    disabled: !siteConfig.repoUrl,
  },
  {
    title: 'Contributing',
    body: 'Start at CONTRIBUTING.md in the repository — verification, hooks, and coverage come first.',
    href: siteConfig.repoUrl ? `${siteConfig.repoUrl}/blob/main/CONTRIBUTING.md` : '',
    external: true,
    disabled: !siteConfig.repoUrl,
  },
  {
    title: 'Documentation',
    body: 'Concepts, configuration, CLI reference, and every reporter format.',
    href: '/docs/',
    external: false,
    disabled: false,
  },
  {
    title: 'Releases',
    body: 'Version history with per-release notes and links to the original GitHub releases.',
    href: '/changelog/',
    external: false,
    disabled: false,
  },
  {
    title: 'npm package',
    body: 'Prebuilt binaries for macOS, Linux, and Windows, published with provenance attestations.',
    href: siteConfig.npmUrl,
    external: true,
    disabled: !siteConfig.npmUrl,
  },
] as const;
---

<section id="community" class="border-t border-line bg-panel/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Community</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
        Open source, verified releases
      </h2>
      <p class="mt-3 leading-relaxed text-muted">
        Packages are published with npm trusted publishing, SHA-256 checksums, Sigstore signatures,
        and build provenance attestations —{' '}
        <code class="font-mono text-[13px]">npm audit signatures</code> verifies them.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) =>
        link.disabled ? (
          <div
            class="rounded-xl border border-dashed border-line bg-bg p-6 opacity-70"
            aria-disabled="true"
          >
            <h3 class="font-semibold">{link.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Link appears once a public URL is configured in
              <code class="font-mono text-xs">src/lib/site.ts</code>.
            </p>
          </div>
        ) : (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="group rounded-xl border border-line bg-bg p-6 transition-colors hover:border-accent"
          >
            <h3 class="font-semibold">
              {link.title}
              {link.external && (
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-1.5 inline h-3 w-3 text-muted transition-colors group-hover:text-accent"
                  aria-hidden="true"
                >
                  <path d="M6 3H3v10h10v-3M9.5 3H13v3.5M13 3l-6 6" />
                </svg>
              )}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{link.body}</p>
          </a>
        ),
      )}
    </div>
  </div>
</section>
