---
import Terminal from '../shared/Terminal.astro';
import { siteConfig } from '../../lib/site';
import { getCurrentVersion } from '../../lib/releases';

const currentVersion = await getCurrentVersion();
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[480px] bg-accent-soft [mask-image:radial-gradient(ellipse_60%_100%_at_50%_0%,black,transparent)]"
    aria-hidden="true"
  ></div>
  <div class="mx-auto grid max-w-6xl gap-12 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-10 lg:pb-28 lg:pt-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1 text-xs font-medium text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {currentVersion} · {siteConfig.license} · static analysis
      </p>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-[3.4rem] lg:leading-[1.08]">
        Find duplicated tests.
        <span class="text-accent">Reduce redundancy.</span>
        Keep your test suite maintainable.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        VitestDedup reads your Vitest test files — never importing or executing them — and reports
        duplicate and near-duplicate tests: identical bodies hiding under different titles,
        structural copies that differ only in literals, whole suites repeated across files.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/docs/quick-start/"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-[#0b0f0d] transition-transform hover:scale-[1.02]"
        >
          Get started
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </a>
        {siteConfig.repoUrl && (
          <a
            href={siteConfig.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            GitHub
          </a>
        )}
        <a
          href="/docs/"
          class="inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-semibold text-muted transition-colors hover:text-ink"
        >
          Read the docs
        </a>
      </div>
      <p class="mt-6 text-xs text-muted">
        Every command shown on this site is real. Sample output is marked as illustrative.
      </p>
    </div>
    <div class="min-w-0">
      <Terminal
        title="vitest-dedup"
        command="npx vitest-dedup ."
        lines={[
          { text: `vitest-dedup ${currentVersion.replace('v', '')}`, tone: 'dim' },
          { text: '' },
          { text: 'duplicate-test (1 error)', tone: 'rule' },
          { text: '  error  same normalized body under an equivalent context', tone: 'out' },
          {
            text: '    --> tests/auth/login.spec.ts:14:1 redirects when signed out',
            tone: 'location',
          },
          { text: '    related: tests/auth/session.spec.ts:22:1 same test', tone: 'location' },
          { text: '    action: review removal or repair of intended coverage', tone: 'accent' },
          { text: '' },
          { text: 'near-duplicate-test (1 warning)', tone: 'rule' },
          { text: '  warning  same behavior under an equivalent context', tone: 'out' },
          { text: '    --> tests/api/users.spec.ts:8:1 lists admin users', tone: 'location' },
          { text: '    related: tests/api/admin-users.spec.ts:31:1 similar', tone: 'location' },
          { text: '    action: review before changing tests', tone: 'accent' },
          { text: '' },
          { text: '318 tests in 42 files analyzed', tone: 'out' },
          { text: 'errors: 1, warnings: 2, off: 0 · threshold: 0%', tone: 'dim' },
          { text: 'Analysis policy: FAIL', tone: 'warn' },
          { text: 'Detection time: 412.7 ms', tone: 'dim' },
        ]}
        note="Real command · output abridged and illustrative"
      />
    </div>
  </div>
</section>
