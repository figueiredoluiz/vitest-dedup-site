---

const steps = [
  {
    title: 'Install',
    code: 'npm install --save-dev vitest-dedup',
    body: 'A prebuilt binary for your platform arrives through optionalDependencies — no postinstall script, nothing compiled or executed at install time.',
  },
  {
    title: 'Analyze',
    code: 'npx vitest-dedup .',
    body: 'Discovery reads your Vitest configuration statically, then every test file is parsed and compared. Nothing is imported or run.',
  },
  {
    title: 'Triage',
    code: 'vitest-dedup . --reporters html',
    body: 'Each finding carries a verdict and an action. Deliberate parallels get a vitest-dedup-disable-next-line comment right in the test.',
  },
  {
    title: 'Gate',
    code: 'vitest-dedup . --baseline dedup-baseline.json',
    body: 'Record existing debt once, then fail only for what new work adds. In CI, the GitHub Action verifies the binary before running it.',
  },
] as const;
---

<section id="workflow" class="border-y border-line bg-panel/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Workflow</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
        From first run to a gate you can trust
      </h2>
    </div>
    <ol class="mt-10 grid gap-4 md:grid-cols-2">
      {
        steps.map((step, index) => (
          <li class="rounded-xl border border-line bg-bg p-6">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent-soft font-mono text-xs font-bold text-accent">
                {index + 1}
              </span>
              <h3 class="font-semibold">{step.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{step.body}</p>
            <code class="mt-4 block overflow-x-auto rounded-lg border border-line bg-panel px-3.5 py-2.5 font-mono text-[13px] text-ink">
              {step.code}
            </code>
          </li>
        ))
      }
    </ol>
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a
        href="/docs/quick-start/"
        class="font-semibold text-accent hover:underline">Quick start guide →</a
      >
      <a href="/docs/ci-integration/" class="font-semibold text-accent hover:underline"
        >CI integration →</a
      >
    </div>
  </div>
</section>
