---
import { siteConfig } from '../../lib/site';

const features = [
  {
    title: 'Body-based identity',
    body: 'Tests are compared by normalized body, not title. Renamed copies get caught; identical bodies under different hooks, mocks, or fixtures are left alone.',
    href: '/docs/detection-concepts/',
    icon: 'fingerprint',
  },
  {
    title: 'Nine focused rules',
    body: 'From exact duplicates and name collisions to parameterization candidates, subsumed tests, and redundant hooks — each with its own severity.',
    href: '/docs/detection-concepts/',
    icon: 'rules',
  },
  {
    title: 'Verdicts, not guesses',
    body: 'Every finding names its remedy: redundant, consolidatable, name collision, or similar-uncertain. Rules configured off are not even computed.',
    href: '/docs/understanding-results/',
    icon: 'verdict',
  },
  {
    title: 'Five report formats',
    body: 'terminal for reading, jsonl for jq and agents, json for diffing runs, html for review, sarif for GitHub code scanning.',
    href: '/docs/reports/',
    icon: 'reports',
  },
  {
    title: 'Gates that adopt gradually',
    body: 'Baseline existing debt and fail only on what a change adds. Scope a run to files changed since a revision, for pull requests.',
    href: '/docs/ci-integration/',
    icon: 'gate',
  },
  {
    title: 'Static, and stays that way',
    body: 'Your tests are read, never imported or executed. Vitest configuration is resolved statically, including monorepo project lists.',
    href: '/docs/configuration/',
    icon: 'static',
  },
] as const;
---

<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Features</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
      Everything the analyzer actually does
    </h2>
    <p class="mt-3 leading-relaxed text-muted">
      No invented capabilities — each of these is shipped behavior of
      {siteConfig.currentVersion}, documented in the
      <a href="/docs/" class="text-accent hover:underline">reference</a>.
    </p>
  </div>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <a
          href={feature.href}
          class="group rounded-xl border border-line bg-panel p-6 transition-colors hover:border-accent"
        >
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft text-accent">
            {feature.icon === 'fingerprint' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
                <path d="M10 2.5a4.5 4.5 0 0 0-4.5 4.5v3a4.5 4.5 0 0 0 9 0M10 11.5v-2M12.8 14a7.5 7.5 0 0 0 1.7-4.5V7a4.5 4.5 0 0 0-2.3-3.9M5.5 14.5a7.4 7.4 0 0 1-.7-3v-1" />
              </svg>
            )}
            {feature.icon === 'rules' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
                <path d="M4 4.5h8M4 8h12M4 11.5h12M4 15h6" />
              </svg>
            )}
            {feature.icon === 'verdict' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M10 2l2.2 4.5 5 .7-3.6 3.5.9 4.9L10 13.3l-4.5 2.3.9-4.9L2.8 7.2l5-.7L10 2z" />
              </svg>
            )}
            {feature.icon === 'reports' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M6 2.5h6l3.5 3.5v11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1zM12 2.5V6h3.5M8 11h6M8 14h4" />
              </svg>
            )}
            {feature.icon === 'gate' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M3 6.5C5.5 4.7 14.5 4.7 17 6.5M4 8.5v6a7 7 0 0 0 12 0v-6M8 2v3M12 2v3M10 14.5a2 2 0 1 0 0-.01" />
              </svg>
            )}
            {feature.icon === 'static' && (
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M8 3H4a1 1 0 0 0-1 1v4M12 3h4a1 1 0 0 1 1 1v4M8 17H4a1 1 0 0 1-1-1v-4M12 17h4a1 1 0 0 0 1-1v-4M7.5 10h5M10 7.5v5" />
              </svg>
            )}
          </span>
          <h3 class="mt-4 font-semibold">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{feature.body}</p>
          <span class="mt-3 inline-block text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </span>
        </a>
      ))
    }
  </div>
</section>
