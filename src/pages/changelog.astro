---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReleases, getCurrentVersion, formatDate } from '../lib/releases';
import { renderMarkdown } from '../lib/markdown';
import { siteConfig } from '../lib/site';

const releases = await getReleases();
const rendered = await Promise.all(
  releases.map(async (release) => ({
    release,
    html: await renderMarkdown(release.body),
  })),
);

const title = `Changelog — ${siteConfig.name}`;
const description = `Release history for VitestDedup, from ${releases[releases.length - 1]?.tagName} to ${await getCurrentVersion()}.`;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Changelog</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Release history</h1>
    <p class="mt-4 leading-relaxed text-muted">
      Every published version, newest first. Entries are served from a local fixture (
      <code class="font-mono text-[13px]">src/data/releases.json</code>) shaped after the GitHub
      Releases API, so the same page can later consume release data at build time.
    </p>

    <div class="mt-10 divide-y divide-line">
      {rendered.map(({ release, html }) => (
        <article class="py-8 first:pt-0">
          <header class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <h2 class="font-mono text-xl font-bold tracking-tight">{release.tagName}</h2>
            {release.prerelease && (
              <span class="rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-0.5 text-xs font-semibold text-amber-600 dark:text-amber-300">
                pre-release
              </span>
            )}
            <time datetime={release.publishedAt} class="text-sm text-muted">
              {formatDate(release.publishedAt)}
            </time>
            {release.url && (
              <a
                href={release.url}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto text-sm font-medium text-accent hover:underline"
              >
                View on GitHub ↗
              </a>
            )}
          </header>
          <div class="md-content mt-4 text-sm" set:html={html} />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
