---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/trending/Breadcrumbs.astro';
import {
  dayPath,
  formatDay,
  formatNumber,
  loadDay,
  reasonLabels,
  ruleLabels,
  trendingIndex,
} from '../../../../lib/trending';
import { siteConfig } from '../../../../lib/site';

export function getStaticPaths() {
  return Object.values(trendingIndex.repos).map((r) => {
    const [owner, repo] = r.name.split('/');
    return { params: { owner, repo } };
  });
}

const name = `${Astro.params.owner}/${Astro.params.repo}`;
const entry = trendingIndex.repos[name];
const day = await loadDay(entry.latest);
const r = day.repos.find((x) => x.name === name)!;
const shortSha = r.headSha.slice(0, 7);
const commitUrl = `${r.url}/tree/${r.headSha}`;
const rules = Object.entries(r.findings.byRule).sort((a, b) => b[1] - a[1]);
const excluded = r.tests.unresolved;
const tiles = [
  {
    label: 'Tests analyzed',
    value: formatNumber(r.tests.analyzed),
    note: `in ${formatNumber(r.tests.files)} files`,
  },
  {
    label: 'Compared',
    value: `${r.comparablePercent}%`,
    note: `${formatNumber(excluded)} tests could not be compared`,
  },
  {
    label: 'Findings',
    value: formatNumber(r.findings.total),
    note: `${formatNumber(r.findings.warnings)} warnings`,
  },
  { label: 'Exact duplicates', value: formatNumber(r.findings.errors), note: 'error severity' },
];
const title = `${name} — trending analysis — ${siteConfig.name}`;
const description = `VitestDedup found ${r.findings.total} duplicate-test candidates in ${formatNumber(r.tests.analyzed)} tests of ${name} at ${shortSha}.`;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <Breadcrumbs
      items={[
        { label: 'Trending', href: '/trending/' },
        { label: formatDay(entry.latest), href: `/trending/day/${entry.latest}/` },
        { label: name, mono: true },
      ]}
    />
    <h1 class="mt-4 break-all font-mono text-3xl font-extrabold tracking-tight sm:text-4xl">
      {name}
    </h1>
    {r.description && <p class="mt-3 max-w-3xl leading-relaxed text-muted">{r.description}</p>}
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
      <a
        href={commitUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline"
      >
        {shortSha} ↗
      </a>
      {r.language && <span>{r.language}</span>}
      <span>
        ★ {formatNumber(r.stars)} (+{formatNumber(r.starsToday)} today)
      </span>
      <span>lists: {r.lists.join(', ')}</span>
      <span>vitest-dedup {day.analyzerVersion}</span>
    </p>

    <dl class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {tiles.map((t) => (
        <div class="rounded-xl border border-line bg-panel px-5 py-4">
          <dt class="text-xs font-medium uppercase tracking-wider text-muted">{t.label}</dt>
          <dd class="mt-1 font-mono text-2xl font-bold">{t.value}</dd>
          <dd class="mt-0.5 text-xs text-muted">{t.note}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-lg font-bold">Top candidates</h2>
        <p class="mt-1 text-sm text-muted">
          The largest findings, linked to the analyzed commit. Review them before changing any test:
          identical bodies can still run under different setups the analyzer does not model.
        </p>
        {r.top.length === 0 && <p class="mt-4 text-sm text-muted">No findings.</p>}
        <ol class="mt-4 space-y-3">
          {r.top.map((f) => (
            <li class="rounded-xl border border-line bg-panel px-5 py-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs font-semibold text-accent">
                  {ruleLabels[f.rule] ?? f.rule}
                </span>
                <span
                  class:list={[
                    'rounded px-1.5 py-0.5 font-mono text-[11px] font-semibold uppercase',
                    f.severity === 'error'
                      ? 'bg-rose-500/15 text-rose-600 dark:text-rose-300'
                      : 'bg-amber-500/15 text-amber-600 dark:text-amber-300',
                  ]}
                >
                  {f.severity}
                </span>
              </div>
              <p class="mt-2 text-sm">{f.message}.</p>
              <ul class="mt-3 space-y-2">
                {f.locations.map((l, i) => (
                  <li class="text-xs">
                    {f.titles[i] && <p class="text-ink">{f.titles[i]}</p>}
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="break-all font-mono text-muted hover:text-accent"
                    >
                      {l.path}:{l.line}–{l.endLine} ↗
                    </a>
                  </li>
                ))}
              </ul>
              {f.more > 0 && <p class="mt-2 text-xs text-muted">and {f.more} more</p>}
            </li>
          ))}
        </ol>
      </div>

      <div class="space-y-6">
        <div class="rounded-xl border border-line bg-panel p-5">
          <h2 class="text-sm font-bold">Findings by rule</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {rules.map(([rule, n]) => (
              <li class="flex justify-between gap-3">
                <span class="text-muted">{ruleLabels[rule] ?? rule}</span>
                <span class="font-mono">{formatNumber(n)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-line bg-panel p-5">
          <h2 class="text-sm font-bold">Not compared</h2>
          {r.exclusions.length === 0 ? (
            <p class="mt-2 text-sm text-muted">Every test was compared.</p>
          ) : (
            <ul class="mt-3 space-y-1.5 text-sm">
              {r.exclusions.map((e) => (
                <li class="flex justify-between gap-3">
                  <span class="text-muted">{reasonLabels[e.reason] ?? e.reason}</span>
                  <span class="font-mono">{formatNumber(e.tests)}</span>
                </li>
              ))}
            </ul>
          )}
          <p class="mt-3 text-xs text-muted">
            No finding is reported for these tests, which does not mean they have no duplicates.
          </p>
        </div>
      </div>
    </div>

    <h2 class="mt-12 text-lg font-bold">Appearances</h2>
    <div class="mt-4 overflow-x-auto rounded-xl border border-line">
      <table class="w-full min-w-[640px] text-sm">
        <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
          <tr>
            <th class="px-4 py-3 font-medium">Day</th>
            <th class="px-4 py-3 font-medium">Rank</th>
            <th class="px-4 py-3 font-medium">Commit</th>
            <th class="px-4 py-3 font-medium">Version</th>
            <th class="px-4 py-3 text-right font-medium">Tests</th>
            <th class="px-4 py-3 text-right font-medium">Compared</th>
            <th class="px-4 py-3 text-right font-medium">Findings</th>
            <th class="px-4 py-3 text-right font-medium">Duplicates</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line font-mono">
          {[...entry.appearances].reverse().map((a) => (
            <tr>
              <td class="px-4 py-2">
                <a href={dayPath(a.date)} class="hover:text-accent">
                  {a.date}
                </a>
              </td>
              <td class="px-4 py-2">{a.rank}</td>
              <td class="px-4 py-2">
                <a
                  href={`${r.url}/tree/${a.headSha}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent"
                >
                  {a.headSha.slice(0, 7)}
                </a>
              </td>
              <td class="px-4 py-2">{a.analyzerVersion}</td>
              <td class="px-4 py-2 text-right">{formatNumber(a.tests)}</td>
              <td class="px-4 py-2 text-right">{a.comparablePercent}%</td>
              <td class="px-4 py-2 text-right">{formatNumber(a.findings)}</td>
              <td class="px-4 py-2 text-right">{formatNumber(a.errors)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 text-lg font-bold">Reproduce</h2>
    <p class="mt-1 text-sm text-muted">The latest analysis, at the same commit and version:</p>
    <pre class="mt-4 overflow-x-auto rounded-xl border border-line bg-panel px-5 py-4 font-mono text-sm"><code>{`git clone ${r.url}.git
cd ${Astro.params.repo}
git checkout ${r.headSha}
npx vitest-dedup@${day.analyzerVersion} .`}</code></pre>
  </section>
</BaseLayout>
